# Copy to .env (git-ignored). Expo only reads .env files from this folder,
# not the repo root. EXPO_PUBLIC_* values are bundled into the app, so never
# put secrets here.

# Where the app reaches the API:
#   Android emulator -> http://10.0.2.2:3000  (the emulator's alias for your Mac)
#   iOS simulator    -> http://localhost:3000
#   Physical phone   -> http://<your Mac's LAN IP>:3000  (same Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
