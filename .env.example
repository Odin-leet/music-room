# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets (V.8 of the brief fails the project on this).

# --- Database (Postgres, run via `make db-up`) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=music_room
DB_PASSWORD=music_room
DB_NAME=music_room_dev

# --- API ---
API_PORT=3000
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES=7d

# --- Social auth (V.1 / V.5 — from Google/Facebook developer consoles) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Mail (email verification + password reset, V.1) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@music-room.app

# --- Mobile client ---
# The app is a "remote control" (V.5) — its backend address must be
# configurable, this is the default it ships with in dev.
EXPO_PUBLIC_API_URL=http://localhost:3000
